<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.3</Version>
    <Description>Attribute-driven EF Core change notifications with scoped SignalR subscriptions.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 IvanKobtsev</Copyright>
    <PackageTags>entityframeworkcore efcore signalr aspnetcore change-tracking subscriptions source-generator dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/IvanKobtsev/EntityTracker.AspNetCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IvanKobtsev/EntityTracker.AspNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EntityTracker.Generator/EntityTracker.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    <None Include="../EntityTracker.Generator/bin/$(Configuration)/netstandard2.0/EntityTracker.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3"/>
    <None Include="../../README.md" Pack="true" PackagePath="/"/>
    <None Include="../../LICENSE" Pack="true" PackagePath="/"/>
  </ItemGroup>
</Project>
